<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:layoutDirection="rtl"
    android:textDirection="rtl"
    android:orientation="vertical">

    <!-- الهيدر العلوي (العنوان وسهم الرجوع) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1E1E2C"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <!-- العنوان والعنوان الفرعي على اليمين -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="start"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvHeaderTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="سجل المحذوفات والأرشيف"
                android:textColor="@android:color/white"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvHeaderSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="استعراض واستعادة الزبائن والحركات المحذوفة"
                android:textColor="#B0BEC5"
                android:textSize="12sp" />

        </LinearLayout>

        <!-- مسافة فاصلة -->
        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- سهم الرجوع على اليسار بمعرف متطابق مع ArchiveActivity -->
        <ImageView
            android:id="@+id/btnBackArchive"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="رجوع"
            android:focusable="true"
            android:src="@drawable/arrow__1_"
            app:tint="@android:color/white" />

    </LinearLayout>

    <!-- شريط التبويب (TabLayout) الذي يربط بين أرشيف الزبائن والحركات -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayoutArchive"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1E1E2C"
        app:tabIndicatorColor="@android:color/white"
        app:tabSelectedTextColor="@android:color/white"
        app:tabTextColor="#94A3B8" />

    <!-- عارض الصفحات (ViewPager2) لعرض محتوى كل تبويب -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPagerArchive"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>